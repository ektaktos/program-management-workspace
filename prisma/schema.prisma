generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String      @id
  name        String
  type        String
  description String      @db.Text
  status      String
  color       String
  start       String?
  end         String?
  tasks       Task[]
  milestones  Milestone[]
  phases      Phase[]
  notes       Note[]
}

model Task {
  id          String   @id
  projectId   String
  phaseId     String?
  title       String
  description String   @db.Text
  status      String
  priority    String
  due         String?
  dueTime     String?
  assignee    String?
  alerts      Json     @default("[]")
  recurring   String?
  subtasks    Json     @default("[]")
  completedAt DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Milestone {
  id        String  @id
  projectId String
  title     String
  desc      String  @db.Text
  date      String?
  status    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Phase {
  id        String  @id
  projectId String
  name      String
  notes     String  @db.Text
  start     String?
  end       String?
  progress  Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id
  projectId String
  title     String
  body      String   @db.Text
  tags      Json     @default("[]")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PlannerTodo {
  id        String   @id
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PlannerEvent {
  id        String   @id
  title     String
  date      String
  category  String
  notes     String   @db.Text
  done      Boolean  @default(false)
  time      String?
  createdAt DateTime @default(now())
}

model PlannerAppointment {
  id        String   @id
  title     String
  date      String
  time      String
  notes     String   @db.Text
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PlannerWeekly {
  weekKey    String @id
  goals      Json   @default("[]")
  notes      String @db.Text
  focus      String @default("")
  focusItems Json   @default("[]")
}
