# Copy this file to .env.local and fill in your MySQL credentials
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Auth.js — NEXTAUTH_URL is the app's public URL; generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Optional: Google sign-in. Leave blank to hide the Google button.
# Authorized redirect URI in Google Cloud: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email via Zoho CPaaS (formerly ZeptoMail) — used for password reset links.
# Token: Zoho CPaaS → Agents → your agent → SMTP/API → API → Send Mail token.
# The sender must be on a domain you've verified in Zoho CPaaS.
# Without a token, development prints emails to the server log instead of sending them.
ZOHO_CPAAS_TOKEN=""
EMAIL_FROM_ADDRESS="noreply@yourdomain.com"
EMAIL_FROM_NAME="Program Management Workspace"
# Optional: override the API endpoint (defaults to https://cpaas.zoho.com/v1.1/email)
ZOHO_CPAAS_API_URL=""
